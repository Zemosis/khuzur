PORT=3001
# Local Postgres (see docs/ARCHITECTURE.md §8 for the podman/docker command)
DATABASE_URL=postgres://khuzur:khuzur@localhost:5432/khuzur
# Signs session tokens. Any long random string: `openssl rand -hex 32`
JWT_SECRET=change-me
CORS_ORIGIN=http://localhost:5173
# Google / Discord sign in (server/oauth.js). A provider's button shows only
# when both its id and secret are set. Register this redirect URL with each:
#   http://localhost:3001/api/auth/oauth/google/callback
#   http://localhost:3001/api/auth/oauth/discord/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Where providers send players back (this server) and where they land after
# (the site). Defaults: http://localhost:$PORT (RENDER_EXTERNAL_URL on Render)
# and the first CORS_ORIGIN.
# PUBLIC_URL=http://localhost:3001
# SITE_URL=http://localhost:5173
# Comma-separated user ids that may open /admin (credits review). Empty: nobody.
ADMIN_USER_IDS=
# Throwaway database for `npm test` (never the one above; the suites truncate it).
# podman exec khuzur-db psql -U khuzur -c "create database khuzur_test owner khuzur"
TEST_DATABASE_URL=postgres://khuzur:khuzur@localhost:5432/khuzur_test
